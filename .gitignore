# Results: ship the canonical evaluation datasets and cached analysis outputs;
# ignore intermediate/large run files and logs.
results/*.log
results/latest_run/*.log
results/latest_run/batch*.jsonl
results/latest_run/benchmark*.jsonl
results/latest_run/latest_10models_5rep.jsonl
# Canonical artifacts that MUST ship for reproduction (benchmark paper requirement):
!results/latest_run/merged_results_5rep.jsonl
!results/control_pilot.jsonl
!results/extended_analysis/

# Generated figures (can be regenerated)
# figures/*.png    # Uncomment to ignore generated figures
# figures/*.pdf    # Uncomment to ignore generated figures

# Temporary files
*.tmp
*.temp
*.log
*.bak
build.log

# Documentation summaries (generated during development)
CHANGES_SUMMARY.md
IMPLEMENTATION_SUMMARY.md
PAPER_UPDATE_SUMMARY.md
PAPER_UPDATES_SUMMARY.md
PROJECT_RESTRUCTURE_PLAN.md

